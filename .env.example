# Copy this file to .env and fill in your key.
# When OPENROUTER_API_KEY is absent, the app runs in stub mode (offline, deterministic, no LLM calls).
OPENROUTER_API_KEY=

# Optional: override the model used for each purpose.
# MODEL_LESSON=deepseek/deepseek-v4-flash:free
# MODEL_QUESTION=deepseek/deepseek-v4-flash:free
# MODEL_GRADER=deepseek/deepseek-v4-flash:free
