# ===========================================================================
# Chinese Learner — Environment Variables
# Copy this file to .env.local and fill in the values.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase (required)
# Get these from: Supabase dashboard → Settings → API
# ---------------------------------------------------------------------------

# Public URL of your Supabase project (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon key (safe to expose to browser — RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon_key

# Supabase service-role key (NEVER expose this — server-only)
# Used only for seeding words and writing shared caches (lesson cards, accepted_answers)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# LLM (optional — stub fallback is used when key is absent)
# OpenCode Zen: https://opencode.ai
# ---------------------------------------------------------------------------

# API key for OpenCode Zen (leaves USE_STUB=true when absent)
LLM_API_KEY=

# Model overrides (optional — all default to deepseek-v4-flash-free)
# MODEL_LESSON=deepseek-v4-flash-free
# MODEL_QUESTION=deepseek-v4-flash-free
# MODEL_GRADER=deepseek-v4-flash-free

# Token budgets (optional)
# LLM_MAX_TOKENS=4096
# LLM_MAX_TOKENS_LESSON=4096
# LLM_MAX_TOKENS_QUESTION=4096   # keep low to avoid Vercel timeout
# LLM_MAX_TOKENS_GRADER=16384
# LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# Auth uses Supabase email + password (no OAuth / Google setup needed).
# In the Supabase dashboard → Authentication, keep the Email provider enabled.
# For a personal app, consider disabling "Confirm email" so sign-up logs in immediately.
# Vercel prod URL + http://localhost:3000 must be in Supabase Auth redirect URLs.
